+namespace {
+
+struct InstanceFloat3 {
+    float values[3];
+};
+
+struct InstanceFloat4 {
+    float values[4];
+};
+
+struct InstanceByte4 {
+    int8_t values[4];
+};
+
+struct InstanceShort4 {
+    int16_t values[4];
+};
+
+template <class T>
+T ReadInstanceAccessorElement(Accessor &accessor, size_t index) {
+    uint8_t *data = accessor.GetPointer();
+    const size_t elementSize = accessor.GetElementSize();
+    const size_t stride = accessor.sparse ? elementSize : accessor.GetStride();
+
+    if (data == nullptr || index >= accessor.count || elementSize > sizeof(T) || stride == 0) {
+        throw DeadlyImportError("GLTF: Invalid EXT_mesh_gpu_instancing accessor ", getContextForErrorMessages(accessor.id, accessor.name));
+    }
+
+    const size_t maxByteSize = accessor.GetMaxByteSize();
+    if (elementSize > maxByteSize || index > (maxByteSize - elementSize) / stride) {
+        throw DeadlyImportError("GLTF: EXT_mesh_gpu_instancing accessor element is out of range in ", getContextForErrorMessages(accessor.id, accessor.name));
+    }
+
+    T value{};
+    memcpy(&value, data + index * stride, elementSize);
+    return value;
+}
+
+static ai_real NormalizeSignedInstanceComponent(int32_t value, int32_t positiveMax) {
+    if (value < -positiveMax) {
+        return static_cast<ai_real>(-1.0f);
+    }
+    return static_cast<ai_real>(static_cast<float>(value) / static_cast<float>(positiveMax));
+}
+
+static aiVector3D ReadInstanceVector3(Accessor &accessor, size_t index) {
+    const InstanceFloat3 value = ReadInstanceAccessorElement<InstanceFloat3>(accessor, index);
+    return aiVector3D(value.values[0], value.values[1], value.values[2]);
+}
+
+static aiQuaternion ReadInstanceQuaternion(Accessor &accessor, size_t index) {
+    aiQuaternion value;
+    if (accessor.componentType == ComponentType_FLOAT) {
+        const InstanceFloat4 raw = ReadInstanceAccessorElement<InstanceFloat4>(accessor, index);
+        value.x = raw.values[0];
+        value.y = raw.values[1];
+        value.z = raw.values[2];
+        value.w = raw.values[3];
+    } else if (accessor.componentType == ComponentType_BYTE) {
+        const InstanceByte4 raw = ReadInstanceAccessorElement<InstanceByte4>(accessor, index);
+        value.x = NormalizeSignedInstanceComponent(raw.values[0], 127);
+        value.y = NormalizeSignedInstanceComponent(raw.values[1], 127);
+        value.z = NormalizeSignedInstanceComponent(raw.values[2], 127);
+        value.w = NormalizeSignedInstanceComponent(raw.values[3], 127);
+    } else {
+        const InstanceShort4 raw = ReadInstanceAccessorElement<InstanceShort4>(accessor, index);
+        value.x = NormalizeSignedInstanceComponent(raw.values[0], 32767);
+        value.y = NormalizeSignedInstanceComponent(raw.values[1], 32767);
+        value.z = NormalizeSignedInstanceComponent(raw.values[2], 32767);
+        value.w = NormalizeSignedInstanceComponent(raw.values[3], 32767);
+    }
+    return value;
+}
+
+static std::vector<aiMatrix4x4> ReadMeshGpuInstanceTransforms(Node &node) {
+    std::vector<aiMatrix4x4> transforms(node.meshGpuInstancing.count);
+
+    for (size_t instanceIndex = 0; instanceIndex < transforms.size(); ++instanceIndex) {
+        aiMatrix4x4 &transform = transforms[instanceIndex];
+
+        if (node.meshGpuInstancing.translation) {
+            aiMatrix4x4 translation;
+            aiMatrix4x4::Translation(ReadInstanceVector3(*node.meshGpuInstancing.translation, instanceIndex), translation);
+            transform = transform * translation;
+        }
+
+        if (node.meshGpuInstancing.rotation) {
+            const aiQuaternion rotation = ReadInstanceQuaternion(*node.meshGpuInstancing.rotation, instanceIndex);
+            transform = transform * aiMatrix4x4(rotation.GetMatrix());
+        }
+
+        if (node.meshGpuInstancing.scale) {
+            aiMatrix4x4 scale;
+            aiMatrix4x4::Scaling(ReadInstanceVector3(*node.meshGpuInstancing.scale, instanceIndex), scale);
+            transform = transform * scale;
+        }
+    }
+
+    return transforms;
+}
+
+static void ExpandMeshGpuInstances(aiNode &ainode, Node &node) {
+    if (!node.meshGpuInstancing.isPresent) {
+        return;
+    }
+
+    std::vector<aiMatrix4x4> transforms = ReadMeshGpuInstanceTransforms(node);
+    if (transforms.size() > std::numeric_limits<unsigned int>::max() - ainode.mNumChildren) {
+        throw DeadlyImportError("GLTF: EXT_mesh_gpu_instancing child count exceeds Assimp node limits on ", getContextForErrorMessages(node.id, node.name));
+    }
+
+    const unsigned int firstInstanceChild = ainode.mNumChildren;
+    const unsigned int expandedChildCount = firstInstanceChild + static_cast<unsigned int>(transforms.size());
+    aiNode **expandedChildren = new aiNode *[expandedChildCount]();
+    if (ainode.mNumChildren > 0) {
+        std::copy(ainode.mChildren, ainode.mChildren + ainode.mNumChildren, expandedChildren);
+    }
+    delete[] ainode.mChildren;
+    ainode.mChildren = expandedChildren;
+    ainode.mNumChildren = expandedChildCount;
+
+    for (size_t instanceIndex = 0; instanceIndex < transforms.size(); ++instanceIndex) {
+        std::unique_ptr<aiNode> instance(new aiNode(GetNodeName(node) + "_instance_" + std::to_string(instanceIndex)));
+        instance->mParent = &ainode;
+        instance->mTransformation = transforms[instanceIndex];
+        instance->mNumMeshes = ainode.mNumMeshes;
+        if (instance->mNumMeshes > 0) {
+            instance->mMeshes = new unsigned int[instance->mNumMeshes];
+            std::copy(ainode.mMeshes, ainode.mMeshes + ainode.mNumMeshes, instance->mMeshes);
+        }
+        ainode.mChildren[firstInstanceChild + static_cast<unsigned int>(instanceIndex)] = instance.release();
+    }
+
+    delete[] ainode.mMeshes;
+    ainode.mMeshes = nullptr;
+    ainode.mNumMeshes = 0;
+}
+
