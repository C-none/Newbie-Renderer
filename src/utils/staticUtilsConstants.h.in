#pragma once
#include <cstdint>
#include <array>
#include <string_view>

namespace nr
{

// Build configuration
#if defined(_DEBUG) || !defined(NDEBUG)
inline constexpr bool isDebugMode = true;
#else
inline constexpr bool isDebugMode = false;
#endif
inline constexpr uint32_t maxThreads = @MAX_THREADS@;

// Log level enumeration (auto-generated from CMake)
enum class LogLevel : uint32_t
{@LOG_LEVEL_ENUM@
};

// Current global log level (set at compile time)
inline constexpr LogLevel globalLogLevel = LogLevel::@LOG_LEVEL_NAME@;

// Display names for log levels
inline constexpr std::array<std::string_view, static_cast<size_t>(LogLevel::number)> logLevelNames = {@LOG_LEVEL_NAMES@};

} // namespace nr
