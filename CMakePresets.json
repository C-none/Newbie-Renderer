{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "environment": {
        "VCPKG_FORCE_SYSTEM_BINARIES": "1",
        "VCPKG_MAX_CONCURRENCY": "$penv{NUMBER_OF_PROCESSORS}"
      },
      "cacheVariables": {
        "VCPKG_FEATURE_FLAGS": "manifests",
        "VCPKG_INSTALL_OPTIONS": "--x-buildtrees-root=${sourceDir}/build/vcpkg/buildtrees;--x-packages-root=${sourceDir}/build/vcpkg/packages;--downloads-root=${sourceDir}/build/vcpkg/downloads",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "NR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "llvm-debug",
      "displayName": "LLVM Clang++ Debug",
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/llvm-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-clang-static",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-triplets"
      }
    },
    {
      "name": "llvm-release",
      "displayName": "LLVM Clang++ Release",
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/llvm-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-clang-static",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-triplets"
      }
    },
    {
      "name": "msvc",
      "displayName": "MSVC",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/msvc",
      "architecture": {
        "value": "x64"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "llvm-debug",
      "jobs": 0
    },
    {
      "name": "release",
      "configurePreset": "llvm-release",
      "jobs": 0
    },
    {
      "name": "debug-msvc",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "jobs": 0
    },
    {
      "name": "release-msvc",
      "configurePreset": "msvc",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "run-debug",
      "inherits": "debug",
      "targets": [
        "run_main"
      ]
    },
    {
      "name": "run-release",
      "inherits": "release",
      "targets": [
        "run_main"
      ]
    },
    {
      "name": "run-debug-msvc",
      "inherits": "debug-msvc",
      "targets": [
        "run_main"
      ]
    },
    {
      "name": "run-release-msvc",
      "inherits": "release-msvc",
      "targets": [
        "run_main"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "llvm-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "llvm-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
